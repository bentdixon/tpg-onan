+@torch.inference_mode()
+def apply_repetition_penalty(logits, contexts, penalty, skip_token=None):
+    """
+    CTRL-style repetition penalty: for every token already in a row's context, divide its
+    logit by penalty if positive and multiply it if negative. Returns a new (B, vocab_size) tensor.
+    """
+    logits = logits.clone()
+    for i, context in enumerate(contexts):
+        seen = set(context)
+        seen.discard(skip_token) # the BOS separator is structure, not content
+        if not seen:
+            continue
+        idx = torch.tensor(sorted(seen), dtype=torch.long, device=logits.device)
+        vals = logits[i, idx]
+        logits[i, idx] = torch.where(vals > 0, vals / penalty, vals * penalty)
+    return logits
+
